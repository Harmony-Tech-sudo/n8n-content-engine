    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst rows = $input.all().map(i => i.json);\nconst pick = rows.find(r => String(r.status).trim() === 'Clips Ready');\nif (!pick) return [];\nlet scenes;\ntry { scenes = JSON.parse(pick.script_json); }\ncatch (e) { throw new Error('script_json is not valid JSON for row ' + pick.id); }\nconst safeId = String(pick.id).replace(/[^A-Za-z0-9_-]/g, '_');\nconst dir = String(cfg.workDir).replace(/[\\\\/]+$/, '') + '/' + safeId;\nconst probe = scenes.map(s =>\n  'ffprobe -v error -show_entries format=duration -of csv=p=0 \"' + dir + '/scene_' + s.n + '.mp4\"'\n).join(' && ');\nreturn [{ json: { ...pick, safeId, scenes, dir, probe } }];\n"
      },
      "id": "e7574a73-febd-5e41-9578-6fa9f85ff03b",
      "name": "Pick Clips Ready",
      "type": "n8n-nodes-base.code",
