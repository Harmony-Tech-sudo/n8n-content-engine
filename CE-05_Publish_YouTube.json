    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst rows = $input.all().map(i => i.json);\nconst today = $now.toFormat('yyyy-MM-dd');\nconst publishedToday = rows.filter(r => String(r.published_at || '').startsWith(today)).length;\nif (publishedToday >= Number(cfg.maxPublishPerDay)) return [];\nconst now = Date.now();\nconst pick = rows.find(r =>\n  String(r.status).trim() === 'Publish' && r.drive_file_id &&\n  (!r.publish_at || isNaN(Date.parse(r.publish_at)) || Date.parse(r.publish_at) <= now)\n);\nif (!pick) return [];\nreturn [{ json: pick }];\n"
      },
