      "id": "52ec4e5f-3847-5bba-bf03-09722f817f4f",
      "name": "Omni Generate",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        2260,
        620
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_ME",
          "name": "Gemini API Key"
        }
      },
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 15000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst r = $json;\nif (r.status && r.status !== 'completed') throw new Error('Omni status: ' + r.status);\nlet uri = null;\nfor (const st of (r.steps || [])) {\n  for (const c of (st.content || [])) {\n    if (c.type === 'video' && c.uri) uri = c.uri;\n  }\n}\nif (!uri) throw new Error('Omni response contained no video URI');\nreturn { json: { uri } };\n",
        "mode": "runOnceForEachItem"
      },
