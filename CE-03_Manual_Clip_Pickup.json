    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst rows = $input.all().map(i => i.json);\nconst pick = rows.find(r => String(r.status).trim() === 'Awaiting Manual Clips');\nif (!pick) return [];\nlet scenes;\ntry { scenes = JSON.parse(pick.script_json); }\ncatch (e) { throw new Error('script_json is not valid JSON for row ' + pick.id); }\nconst safeId = String(pick.id).replace(/[^A-Za-z0-9_-]/g, '_');\nconst dir = String(cfg.workDir).replace(/[\\\\/]+$/, '') + '/' + safeId;\nreturn [{ json: { ...pick, safeId, scenes, dir } }];\n"
      },
      "id": "913b2017-b8fa-5adc-8b6d-d2039e899d3b",
      "name": "Pick Waiting",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "resource": "fileFolder",
        "operation": "search",
        "searchMethod": "name",
        "queryString": "={{ $json.safeId + '_s' }}",
        "returnAll": true,
        "filter": {
          "folderId": {
            "__rl": true,
            "value": "={{ $('Config').first().json.manualFolderId }}",
            "mode": "id"
          }
        },
        "options": {}
      },
      "id": "44223536-c469-5b99-a689-d894b108db03",
      "name": "Search Manual Folder",
      "type": "n8n-nodes-base.googleDrive",
      "typeVersion": 3,
      "position": [
        900,
        300
      ],
      "credentials": {
        "googleDriveOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Drive account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst pick = $('Pick Waiting').first().json;\nconst out = [];\nfor (const it of $input.all()) {\n  const f = it.json;\n  if (!f || !f.id || !f.name) continue;\n  const m = String(f.name).match(/_s(\\d+)\\.(mp4|mov|webm|m4v)$/i);\n  if (!m) continue;\n  if (!String(f.name).startsWith(pick.safeId + '_s')) continue;\n  out.push({ json: { fileId: f.id, name: f.name, n: parseInt(m[1], 10), target: pick.dir + '/scene_' + parseInt(m[1], 10) + '.mp4' } });\n}\nreturn out;\n"
      },
