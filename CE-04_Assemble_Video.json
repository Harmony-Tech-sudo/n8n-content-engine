    {
      "parameters": {
        "command": "={{ $('Pick Clips Ready').first().json.probe }}"
      },
      "id": "057ded6e-7e40-50a6-99e9-8b121372b5e7",
      "name": "Probe Durations",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "jsCode": "\nconst pick = $('Pick Clips Ready').first().json;\nconst durs = String($input.first().json.stdout || '').trim().split(/\\r?\\n/).map(s => parseFloat(s)).filter(x => !isNaN(x));\nconst scenes = pick.scenes;\nif (durs.length !== scenes.length) throw new Error('Expected ' + scenes.length + ' clip durations but got ' + durs.length);\n\nconst p = (n, l = 2) => String(n).padStart(l, '0');\nconst fmt = (t) => {\n  const ms = Math.max(0, Math.round(t * 1000));\n  return p(Math.floor(ms / 3600000)) + ':' + p(Math.floor(ms % 3600000 / 60000)) + ':' + p(Math.floor(ms % 60000 / 1000)) + ',' + p(ms % 1000, 3);\n};\n\n// Caption timing: split each scene's caption into 4-word chunks spread across the clip\nlet t = 0, idx = 1, srt = '';\nscenes.forEach((sc, i) => {\n  const dur = durs[i];\n  const words = String(sc.caption || sc.spoken_line || '').trim().split(/\\s+/).filter(Boolean);\n  if (words.length) {\n    const lead = Math.min(0.3, dur * 0.05), tail = Math.min(0.4, dur * 0.08);\n    const span = Math.max(0.5, dur - lead - tail);\n    const chunks = [];\n    for (let k = 0; k < words.length; k += 4) chunks.push(words.slice(k, k + 4));\n    let cur = t + lead;\n    chunks.forEach(ch => {\n      const d = span * ch.length / words.length;\n      srt += idx++ + '\\n' + fmt(cur) + ' --> ' + fmt(cur + d) + '\\n' + ch.join(' ') + '\\n\\n';\n      cur += d;\n    });\n  }\n  t += dur;\n});\n\n// ffmpeg: normalise every clip to 1080x1920 / 30fps / stereo 44.1k, join them, then burn the captions in\nconst inputs = scenes.map(s => '-i \"scene_' + s.n + '.mp4\"').join(' ');\nlet fc = '';\nscenes.forEach((s, i) => {\n  fc += '[' + i + ':v]scale=1080:1920:force_original_aspect_ratio=decrease,pad=1080:1920:(ow-iw)/2:(oh-ih)/2,setsar=1,fps=30[v' + i + '];' +\n        '[' + i + ':a]aresample=44100,aformat=channel_layouts=stereo[a' + i + '];';\n});\nfc += scenes.map((s, i) => '[v' + i + '][a' + i + ']').join('') + 'concat=n=' + scenes.length + ':v=1:a=1[outv][outa]';\nconst enc = '-c:v libx264 -preset medium -crf 20 -pix_fmt yuv420p';\nconst cmd1 = 'ffmpeg -y -hide_banner -loglevel error ' + inputs + ' -filter_complex \"' + fc + '\" -map \"[outv]\" -map \"[outa]\" ' + enc + ' -c:a aac -b:a 160k joined.mp4';\nconst style = 'Bold=1\\\\,FontSize=11\\\\,Outline=2\\\\,Alignment=2\\\\,MarginV=30';\nconst cmd2 = 'ffmpeg -y -hide_banner -loglevel error -i joined.mp4 -vf \"subtitles=captions.srt:force_style=' + style + '\" ' + enc + ' -c:a copy final.mp4';\n\nreturn [{ json: { id: pick.id, safeId: pick.safeId, dir: pick.dir, srt, command: 'cd \"' + pick.dir + '\" && ' + cmd1 + ' && ' + cmd2 } }];\n"
      },
