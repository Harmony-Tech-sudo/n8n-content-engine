      "id": "0632e99b-6569-57e9-8710-f22f631f6ced",
      "name": "Scan Clip Folder",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "\nconst pick = $('Pick Work').first().json;\nconst out = String($input.first().json.stdout || '').trim();\nconst have = new Set(out.split(',').map(s => s.trim()).filter(Boolean));\n\nconst compose = (s) => {\n  const core = String(s.visual_prompt).trim();\n  const talk = s.spoken_line ? 'The speaker says: \"' + String(s.spoken_line).trim() + '\"' : 'No dialogue.';\n  return core + ' ' + talk + ' Vertical 9:16 framing. A single continuous shot with no scene cuts, about 8 seconds long. No on-screen text, captions or watermarks.';\n};\n\nconst missing = pick.scenes.filter(s => !have.has('scene_' + s.n + '.mp4'));\nif (!missing.length) return [{ json: { allDone: true, id: pick.id } }];\n\nconst s = missing[0];\nreturn [{ json: {\n  allDone: false,\n  id: pick.id,\n  n: s.n,\n  total: pick.scenes.length,\n  provider: pick.provider,\n  prompt: compose(s),\n  file: pick.dir + '/scene_' + s.n + '.mp4',\n  missing: missing.map(m => ({ n: m.n, prompt: compose(m) }))\n}}];\n"
      },
