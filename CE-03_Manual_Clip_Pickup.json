      "id": "3a036501-d04d-5ba0-ab52-e8f397cf640b",
      "name": "Scan Clip Folder",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [
        1780,
        300
      ],
      "executeOnce": true
    },
    {
      "parameters": {
        "jsCode": "\nconst pick = $('Pick Waiting').first().json;\nconst have = new Set(String($input.first().json.stdout || '').trim().split(',').map(s => s.trim()).filter(Boolean));\nconst missing = pick.scenes.filter(s => !have.has('scene_' + s.n + '.mp4')).map(s => s.n);\nreturn [{ json: { complete: missing.length === 0, missing } }];\n"
      },
