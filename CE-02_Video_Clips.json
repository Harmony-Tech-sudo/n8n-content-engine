    {
      "parameters": {
        "jsCode": "\nif ($runIndex > 45) throw new Error('Veo timed out after about 22 minutes');\nconst r = $json;\nif (r.error) throw new Error('Veo error: ' + JSON.stringify(r.error).slice(0, 300));\nif (!r.done) return { json: { done: false } };\nconst gv = r.response && r.response.generateVideoResponse;\nconst uri = gv && gv.generatedSamples && gv.generatedSamples[0] && gv.generatedSamples[0].video && gv.generatedSamples[0].video.uri;\nif (!uri) throw new Error('Veo finished without a video (probably blocked by safety filters): ' + JSON.stringify((gv && gv.raiMediaFilteredReasons) || gv || r).slice(0, 300));\nreturn { json: { done: true, uri } };\n",
        "mode": "runOnceForEachItem"
      },
