      "id": "8123d3e2-2a3f-598f-a0e7-20bd81ec658c",
      "name": "Get Content Rows",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "googleSheetsOAuth2Api": {
          "id": "REPLACE_ME",
          "name": "Google Sheets account"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst rows = $input.all().map(i => i.json);\nconst now = Date.now();\nconst today = $now.toFormat('yyyy-MM-dd');\n\nconst startedToday = rows.filter(r => String(r.video_started_at || '').startsWith(today)).length;\n\n// Rows that are ready for clips and not locked by another run\nconst cands = rows.filter(r =>\n  ['Approved', 'Rendering'].includes(String(r.status).trim()) &&\n  !(r.lock_until && Date.parse(r.lock_until) > now)\n);\ncands.sort((a, b) => (a.status === 'Rendering' ? 0 : 1) - (b.status === 'Rendering' ? 0 : 1));\nconst pick = cands[0];\nif (!pick) return [];\n\n// Daily cap only blocks NEW videos; one already in progress may continue\nif (String(pick.status).trim() !== 'Rendering' && startedToday >= Number(cfg.maxVideosPerDay)) return [];\n\nlet scenes;\ntry { scenes = JSON.parse(pick.script_json); }\ncatch (e) { throw new Error('script_json is not valid JSON for row ' + pick.id); }\nif (!Array.isArray(scenes) || !scenes.length) throw new Error('script_json has no scenes for row ' + pick.id);\n\nconst safeId = String(pick.id).replace(/[^A-Za-z0-9_-]/g, '_');\nconst dir = String(cfg.workDir).replace(/[\\\\/]+$/, '') + '/' + safeId;\nconst provider = String(pick.video_provider || cfg.defaultProvider || 'omni_api').trim();\n\nreturn [{ json: { ...pick, safeId, scenes, dir, provider } }];\n"
      },
