    {
      "parameters": {
        "jsCode": "\nconst cfg = $('Config').first().json;\nconst brief = $('Take One').first().json;\nconst tpls = $input.all().map(i => i.json).filter(t => t && t.name);\nconst want = String(brief.template_name || '').trim().toLowerCase();\nconst tpl = tpls.find(t => String(t.name).trim().toLowerCase() === want) || tpls[0] || {};\n\nconst attempt = parseInt(brief.attempts || '0', 10) || 0;\nconst sceneCount = parseInt(brief.scene_count || tpl.scene_count || cfg.defaultSceneCount, 10) || 4;\nconst minW = parseInt(tpl.min_words || cfg.defaultMinWords, 10);\nconst maxW = parseInt(tpl.max_words || cfg.defaultMaxWords, 10);\nconst language = brief.language || 'English';\nconst banned = String(tpl.banned_phrases || '').split(',').map(s => s.trim()).filter(Boolean);\n\nif (!brief.topic || !brief.keyword) {\n  throw new Error('Row ' + brief.id + ' needs both topic and keyword.');\n}\n\nconst system = [\n  'You are a senior content writer and short-form video director. Follow the brand voice strictly.',\n  '',\n  'BRAND VOICE:',\n  tpl.voice || 'Clear, friendly, expert. No hype.',\n  '',\n  'RULES:',\n  tpl.rules || 'Be accurate. Never invent statistics, quotes or sources.',\n  '',\n  'NEVER use these words or phrases: ' + (banned.join('; ') || '(none)') + '.',\n  '',\n  'Write in: ' + language + '.',\n  'Return ONLY valid JSON. No markdown fences and no commentary.'\n].join('\\n');\n\nlet user = [\n  'Create a content package.',\n  '',\n  'Topic: ' + brief.topic,\n  'Primary keyword: ' + brief.keyword,\n  'Audience: ' + (brief.audience || 'general audience'),\n  'Tone: ' + (brief.tone || 'as per brand voice'),\n  'Call to action: ' + (tpl.cta || 'none'),\n  '',\n  'Requirements:',\n  '1. blog_md: a blog post in Markdown, between ' + minW + ' and ' + maxW + ' words, with one H1 title, H2 sections and a short conclusion. Use the primary keyword in the title, in the first 100 words, and naturally 3-6 more times. Do not stuff keywords. Do not invent facts or statistics.',\n  '2. blog_title and meta_description (max 155 characters).',\n  '3. yt_title (max 70 characters), yt_description (2-3 sentences, no hashtags), yt_tags (array of 5-10 short tags), caption (social caption, max 220 characters).',\n  '4. scenes: exactly ' + sceneCount + ' scenes for a vertical short video of about ' + (sceneCount * 8) + ' seconds. Each scene is ONE continuous 8-second shot. Each scene has: n (1,2,3...), visual_prompt, spoken_line, caption.',\n  '   - visual_prompt: 40-80 words covering subject, action, setting, camera movement and lighting. Re-describe the same recurring character and setting in EVERY scene so the look stays consistent. No on-screen text, no logos.',\n  '   - spoken_line: max 16 words. Scene 1 must hook the viewer. The last scene ends with the call to action.',\n  '   - caption: the on-screen caption for the scene (usually identical to spoken_line).'\n].join('\\n');\n\nif (attempt > 0 && brief.qa_notes) {\n  user += '\\n\\nYour previous attempt FAILED these quality checks. Fix exactly these problems:\\n' + brief.qa_notes;\n}\nuser += '\\n\\nReturn JSON with exactly these keys: blog_title, meta_description, blog_md, yt_title, yt_description, yt_tags, caption, scenes.';\n\nreturn [{ json: {\n  id: brief.id, attempt, sceneCount, minW, maxW, banned, keyword: brief.keyword, topic: brief.topic,\n  requestBody: {\n    systemInstruction: { parts: [{ text: system }] },\n    contents: [{ role: 'user', parts: [{ text: user }] }],\n    generationConfig: { responseMimeType: 'application/json', temperature: 0.8, maxOutputTokens: 8192 }\n  }\n}}];\n"
      },
