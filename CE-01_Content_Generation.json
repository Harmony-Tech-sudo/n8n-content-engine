    {
      "parameters": {
        "jsCode": "\nconst ctx = $('Build Prompt').first().json;\nconst cfg = $('Config').first().json;\nconst resp = $input.first().json;\nconst issues = [];\nlet d = null;\n\ntry {\n  const parts = (resp.candidates && resp.candidates[0] && resp.candidates[0].content && resp.candidates[0].content.parts) || [];\n  let text = parts.filter(p => p.text && !p.thought).map(p => p.text).join('').trim();\n  text = text.replace(/^```(?:json)?\\s*/i, '').replace(/```\\s*$/, '').trim();\n  d = JSON.parse(text);\n} catch (e) {\n  issues.push('Output was not valid JSON (' + e.message + ')');\n}\n\nlet content = null;\nif (d) {\n  for (const k of ['blog_title','meta_description','blog_md','yt_title','yt_description','yt_tags','caption','scenes']) {\n    if (d[k] === undefined || d[k] === null || d[k] === '') issues.push('Missing field: ' + k);\n  }\n  const blog = String(d.blog_md || '');\n  const words = blog.split(/\\s+/).filter(Boolean).length;\n  if (words < ctx.minW) issues.push('Blog too short: ' + words + ' words (minimum ' + ctx.minW + ')');\n  if (words > ctx.maxW) issues.push('Blog too long: ' + words + ' words (maximum ' + ctx.maxW + ')');\n\n  const kw = String(ctx.keyword || '').trim().toLowerCase();\n  if (kw) {\n    const esc = kw.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    const hits = (blog.toLowerCase().match(new RegExp(esc, 'g')) || []).length;\n    const density = words ? (hits / words * 100) : 0;\n    if (!String(d.blog_title || '').toLowerCase().includes(kw)) issues.push('Keyword is missing from blog_title');\n    const first100 = blog.split(/\\s+/).slice(0, 100).join(' ').toLowerCase();\n    if (!first100.includes(kw)) issues.push('Keyword is missing from the first 100 words');\n    if (density < Number(cfg.minDensity)) issues.push('Keyword density too low: ' + density.toFixed(2) + '% (minimum ' + cfg.minDensity + '%)');\n    if (density > Number(cfg.maxDensity)) issues.push('Keyword density too high: ' + density.toFixed(2) + '% (maximum ' + cfg.maxDensity + '%)');\n  }\n\n  const hay = JSON.stringify(d).toLowerCase();\n  for (const b of ctx.banned) {\n    if (hay.includes(b.toLowerCase())) issues.push('Banned phrase used: \"' + b + '\"');\n  }\n\n  if (String(d.yt_title || '').length > 100) issues.push('yt_title is longer than 100 characters');\n\n  if (!Array.isArray(d.scenes)) {\n    issues.push('scenes is not an array');\n  } else {\n    if (d.scenes.length !== ctx.sceneCount) issues.push('Expected ' + ctx.sceneCount + ' scenes but got ' + d.scenes.length);\n    d.scenes.forEach((s, i) => {\n      if (!s.visual_prompt || String(s.visual_prompt).length < 40) issues.push('Scene ' + (i + 1) + ': visual_prompt is missing or too short');\n      const w = String(s.spoken_line || '').split(/\\s+/).filter(Boolean).length;\n      if (w > 20) issues.push('Scene ' + (i + 1) + ': spoken_line has ' + w + ' words (maximum 20 so it fits in 8 seconds)');\n    });\n  }\n\n  if (issues.length === 0) {\n    content = {\n      blog_title: d.blog_title,\n      meta_description: d.meta_description,\n      blog_md: d.blog_md,\n      yt_title: d.yt_title,\n      yt_description: d.yt_description,\n      yt_tags: Array.isArray(d.yt_tags) ? d.yt_tags.join(',') : String(d.yt_tags),\n      caption: d.caption,\n      script_json: JSON.stringify(d.scenes.map((s, i) => ({\n        n: i + 1, visual_prompt: s.visual_prompt, spoken_line: s.spoken_line || '', caption: s.caption || s.spoken_line || ''\n      })))\n    };\n  }\n}\n\nconst attempts = ctx.attempt + 1;\nconst pass = issues.length === 0;\nreturn [{ json: {\n  id: ctx.id, pass, issues, attempts,\n  nextStatus: attempts >= Number(cfg.maxAttempts) ? 'QA Failed' : 'Ready',\n  qaNotes: issues.map(i => '- ' + i).join('\\n'),\n  content\n}}];\n"
      },
