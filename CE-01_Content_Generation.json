      "id": "c59842b9-66c0-5782-9f46-82717503a7dd",
      "name": "Mark Gemini Error",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        1580,
        560
      ],
      "credentials": {
