    {
      "parameters": {
        "jsCode": "\nconst pick = $('Pick Work').first().json;\nconst ns = $('Next Scene').first().json;\nconst cfg = $('Config').first().json;\nconst byChoice = pick.provider === 'manual_drop';\nconst reason = byChoice\n  ? 'Manual provider selected for this row.'\n  : 'Automatic generation failed for scene ' + ns.n + ' (Omni, then Veo). See the n8n execution for details.';\n\nconst lines = ns.missing.map(m =>\n  'SCENE ' + m.n + '  ->  save as  ' + pick.safeId + '_s' + m.n + '.mp4\\n' + m.prompt\n).join('\\n\\n');\n\nconst body =\n  'Row: ' + pick.id + '\\n' + reason + '\\n\\n' +\n  'Generate each scene below in Google Flow (Omni Flash or Veo, vertical 9:16, about 8 seconds, with audio).\\n' +\n  'Download each clip and upload it to this Drive folder:\\n' +\n  'https://drive.google.com/drive/folders/' + cfg.manualFolderId + '\\n\\n' +\n  'File names must be EXACTLY as shown. The workflow CE-03 checks the folder every 10 minutes.\\n\\n' +\n  lines;\n\nreturn [{ json: { reason, subject: 'Manual clips needed: ' + pick.id, body } }];\n"
      },
